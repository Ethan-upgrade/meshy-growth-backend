# These are already baked into docker-compose.yml as defaults for local dev.
# Override here (and point docker-compose.yml at them) only if you need to
# run against a different MySQL/Redis/Kafka, or once you swap the stub
# adplatform clients for real HTTP calls and need real credentials.

# MYSQL_DSN=app:app@tcp(mysql:3306)/growth?parseTime=true&multiStatements=true
# REDIS_ADDR=redis:6379
# KAFKA_BROKERS=kafka:9092

# Real ad platform credentials (not read by the stub clients yet, see
# internal/adplatform/*.go for where to plug them in):
# META_ACCESS_TOKEN=
# META_PIXEL_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_PIXEL_CODE=
